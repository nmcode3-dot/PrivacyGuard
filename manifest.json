{
  "manifest_version": 3,
  "name": "PrivacyGuard",
  "version": "0.1.0",
  "description": "Detect potentially sensitive information before it is submitted through web forms.",
  "action": {
    "default_title": "PrivacyGuard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "camera-monitor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "permissions": [
    "contentSettings"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
