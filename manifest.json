{
  "manifest_version": 3,
  "name": "PrivacyGuard",
  "version": "0.2.0",
  "description": "Detect privacy risks and suspicious website signals before you share information.",
  "action": {
    "default_title": "PrivacyGuard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["camera-monitor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "permissions": ["contentSettings", "activeTab", "cookies", "notifications", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["<all_urls>"]
}